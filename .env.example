# ── 프론트(브라우저)에 넣어도 되는 공개 값 ───────────────
# 정적 사이트이므로 index.html의 AUTH_CONFIG / SUPPORT_CONFIG 에 직접 채웁니다.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY          # 공개 키(안전)

# ── 서버 전용(Edge Function Secret). 브라우저에 절대 노출 금지 ──
SUPABASE_SERVICE_ROLE_KEY=__server_only__
RESEND_API_KEY=__server_only__
DEVELOPER_EMAIL=skysky02209@gmail.com
